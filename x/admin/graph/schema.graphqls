# Admin API for sql-mcp-server. The read model exposes every part of the
# configuration as structured types; writes create revision drafts from a
# base revision plus replaced sections, so the console can evolve without
# server changes. Validation, diff and simulation accept unsaved drafts.
#
# Like the configuration encoding, the model omits empty values: optional text
# is null when unset, and an empty string in an input means unset.

scalar Time
scalar JSON

enum RevisionState {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ROLLED_BACK
  "A draft an administrator decided not to publish."
  DISCARDED
}

enum Action {
  READ
  CREATE
  UPDATE
  DELETE
  EXECUTE
  AGGREGATE
}

enum ImportStatus {
  "No configured entity reads this table."
  NEW
  "An entity of the same datasource already reads this table."
  CONFIGURED
}

type Query {
  "The signed-in administrator."
  me: AdminAccount!
  "The serving process: the revision it applies and whether it follows publishes."
  serverStatus: ServerStatus!
  "The configuration JSON Schema, for editor completion and checks."
  configSchema: JSON!
  "The published revision, if any."
  published: Revision
  revision(id: ID!): Revision
  "Revisions, newest first."
  revisions(limit: Int = 50): [Revision!]!
  """
  The schemas (MySQL databases) of a configured datasource, to scan one at a
  time with startSchemaScan. The list is kept until refresh asks for a new one.
  """
  schemaList(datasource: String!, refresh: Boolean = false): SchemaList!
  """
  The tables of the scanned ones of `schemas`, or of every scanned schema
  when omitted ("" is the default schema of a datasource that cannot list
  schemas), compared with the published configuration. Candidate names and
  relationships are worked out over every scanned schema of the datasource,
  so tables shown together are read in one call. Scans are kept until the next
  scan of the schema.
  """
  schemaTables(datasource: String!, schemas: [String!]): SchemaImport!
  "A schema scan started with startSchemaScan; null when unknown or expired."
  schemaScan(id: ID!): ScanJob
  """
  Database comments of tables: the default descriptions of entities and their
  fields, used when the configuration leaves them empty. Results follow the
  order of `tables`; an entry is null when its table is not found.
  """
  tableComments(tables: [TableRef!]!): [TableComments]!
  "Validate a configuration: a revision, or (default) the signed-in administrator's workspace."
  validate(revision: ID): Validation!
  """
  What the routed datasource connections may do per entity action, as the
  databases reported after the serving snapshot was assembled (assessed in the
  background; empty until then). It informs; each database decides its
  statements.
  """
  capabilities: [EntityCapability!]!
  """
  What each serving connection guarantees (provider capabilities, judged from
  how the connection was opened), and the statement timeouts the serving
  configuration relies on that its connections do not enforce.
  """
  providerCapabilities: ProviderCapabilities!
  "Unified diff from revision `from` to revision `to` (default: the signed-in administrator's workspace)."
  diff(from: ID!, to: ID): String!
  "Evaluate one authorization offline against a revision (default: the signed-in administrator's workspace)."
  simulate(input: SimulationInput!): Simulation!
  "Every entity and applicable action for one principal, default projection."
  visibility(input: VisibilityInput!): [EntityVisibility!]!
  "One page of `visibility`, filtered and counted on the server."
  visibilityPage(input: VisibilityInput!, filter: VisibilityFilter, offset: Int = 0, limit: Int = 50): VisibilityPage!
  adminAccounts: [AdminAccount!]!
}

type Mutation {
  """
  Scan a configured datasource in the background; poll schemaScan until it is
  done, then read the proposed zero-permission entities with schemaTables.
  Each scan uses a connection of its own and a bounded pool of workers, so
  serving never waits for it.
  """
  startSchemaScan(datasource: String!, schemas: [String!]): ScanJob!
  "Stop a pending or running scan."
  cancelSchemaScan(id: ID!): ScanJob
  publish(input: PublishInput!): Revision!
  "Roll back to `to`, or to the newest earlier published content."
  rollback(input: RollbackInput!): Revision!
  "Discards a draft: it stays in the history and is never published."
  discardDraft(id: ID!): Revision!
  "A new random user token; only the hash belongs in a draft."
  generateUserToken: UserToken!
  createAdminAccount(input: AdminAccountInput!): AdminAccount!
  updateAdminAccount(input: AdminAccountUpdate!): AdminAccount!
  "Administrators with admin:accounts may reset anyone; others only themselves."
  setAdminPassword(input: SetAdminPasswordInput!): AdminAccount!
}

type AdminAccount {
  username: String!
  permissions: [String!]!
  disabled: Boolean!
  createdAt: Time!
  updatedAt: Time!
}

type Revision {
  id: ID!
  parent: ID
  state: RevisionState!
  contentHash: String!
  author: String!
  comment: String!
  createdAt: Time!
  publishedAt: Time
  config: Configuration!
  """
  The configuration as a workspace holds it: entities, roles, users and
  settings, in the shape of EntityInput, RoleInput and UserInput.
  """
  sections: JSON!
  """
  The YAML payload in the current encoding, with its secrets (DSN passwords,
  the HTTP token) redacted.
  """
  yaml: String!
}

type Configuration {
  datasources: [Datasource!]!
  entities: [Entity!]!
  roles: [Role!]!
  users: [User!]!
  "Every other top-level section (server, tools, cost, budget, cache, ...) as YAML-shaped JSON."
  settings: JSON!
}

type Datasource {
  name: String!
  driver: String!
  "The read connection's DSN with passwords redacted."
  dsn: String!
  connections: [DatasourceConnection!]!
  "The connection reads, writes and procedure calls use."
  routing: DatasourceRouting!
  "How long a session reads from the write connection after writing (a Go duration); empty when off."
  readAfterWrite: String
  "Set when the datasource admits the SQL escape hatch (execute_sql); null otherwise."
  sqlEscape: DatasourceSqlEscape
}

type DatasourceSqlEscape {
  "The connection execute_sql runs on; its account bounds the hatch."
  connection: String!
}

type DatasourceConnection {
  name: String!
  "The DSN with passwords redacted."
  dsn: String!
  "primary or replica."
  role: String!
  "transaction behind a transaction-mode pooler; null otherwise."
  pooler: String
}

type DatasourceRouting {
  read: String!
  write: String!
  execute: String!
}

"""
An entity as the configuration says it: an unset value is null (its default
applies) and lists are written empty. Its shape is EntityInput's.
"""
type Entity {
  "Unique within the datasource and schema."
  name: String!
  "The table, view or procedure; null means the entity name."
  source: String
  "null means the datasource named default."
  datasource: String
  schema: String
  "table, view or procedure; null means table."
  kind: String
  description: String
  primaryKey: [String!]!
  "Unique keys, each a field list, that identify one row like the primary key."
  uniqueKeys: [[String!]!]!
  fields: [Field!]!
  relationships: [Relationship!]!
  tenantPolicy: JSON
  "Entity-level roles, fieldACL and rowPolicies, kept for compatibility."
  legacyAccess: JSON
  "null when none is set: the DML tools stay on."
  mcp: EntityMCP
  params: [String!]!
  "Entities a procedure writes; empty invalidates its datasource's cached reads."
  affects: [String!]!
  "Admit deletes and key updates that foreign keys cascade to other tables without checking permissions there."
  allowCascade: Boolean
  "Let update_records assign the columns that identify a row."
  allowKeyUpdate: Boolean
}

type Field {
  name: String!
  alias: String
  description: String
  mask: String
  exclude: Boolean
}

type Relationship {
  name: String!
  target: String!
  cardinality: String!
  joinOn: JSON!
}

"An entity's MCP flags as set; an unset dmlTools defaults on."
type EntityMCP {
  dmlTools: Boolean
  customTool: Boolean
  trustedProcedure: Boolean
}

type Role {
  name: String!
  description: String
  grants: [Grant!]!
  "System permissions: sql:execute@<datasource> admits the role's users to execute_sql on that datasource."
  permissions: [String!]!
  "Limits tightening the global ones for the role's calls, as the configuration writes them (roles.<name>.limits); null when none."
  limits: JSON
}

type Grant {
  entity: String!
  actions: [Action!]!
  "False or null grants every visible field; true limits to readFields/writeFields."
  fieldsRestricted: Boolean
  readFields: [String!]!
  writeFields: [String!]!
  rows: JSON
}

type User {
  name: String!
  description: String
  roles: [String!]!
  grants: [Grant!]!
  "System permissions of the user's own, united with its roles' (same values as a role's)."
  permissions: [String!]!
  subject: JSON
  disabled: Boolean
  "The sha256 hash of the user's bearer token (never the token); null when none."
  tokenHash: String
  "Limits tightening the global ones for the user's calls (users.<name>.limits); null when none."
  limits: JSON
}

type SchemaList {
  datasource: String!
  """
  Every user schema; when the database cannot list them, one named "" for its
  default schema, which a scan without schemas reads.
  """
  schemas: [SchemaInfo!]!
  "Where unqualified names resolve; null when unknown."
  defaultSchema: String
  listedAt: Time!
  """
  Identifies the database the datasource reads (its driver and read
  connection); results of another source are stale.
  """
  source: String!
}

type SchemaInfo {
  name: String!
  "When its tables were last scanned; null when never."
  scannedAt: Time
  "How many tables the last scan found; null when never scanned."
  tables: Int
}

enum ScanState {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELED
}

type ScanJob {
  id: ID!
  datasource: String!
  state: ScanState!
  "Why the scan failed or stopped."
  error: String
}

type SchemaImport {
  datasource: String!
  """
  The schema where entities without a schema read (unqualified names
  resolve); null when the database cannot report it.
  """
  defaultSchema: String
  tables: [ImportTable!]!
  """
  Identifies the database the datasource reads (its driver and read
  connection); results of another source are stale.
  """
  source: String!
}

type ImportTable {
  schema: String!
  table: String!
  description: String!
  status: ImportStatus!
  "The configured entity name when status is CONFIGURED."
  configuredAs: String
  columns: [ImportColumn!]!
  "The primary key and unique keys, including those that cannot identify a row."
  keys: [ImportKey!]!
  "Every index, in the database's own terms; the unique ones are also keys."
  indexes: [ImportIndex!]!
  foreignKeys: [ImportForeignKey!]!
  "Triggers or rules: a write may change other tables."
  sideEffects: Boolean!
  "A zero-permission entity proposal; add it to a draft to configure it."
  candidate: Entity!
}

type ImportKey {
  name: String!
  columns: [String!]!
  primary: Boolean!
  "Why the key cannot identify a row (partial, expression, prefix, nullable); null when it can."
  reason: String
}

type ImportIndex {
  name: String!
  """
  The database's name for the index structure, lower-cased: for example
  btree, hash, gin, gist, brin, spgist (PostgreSQL); btree, hash, fulltext,
  spatial (MySQL, OceanBase).
  """
  method: String!
  """
  Key parts in order: a column, a column prefix such as title(20), or an
  expression as the database prints it; parts the database does not report
  are left out (empty when it reports none).
  """
  parts: [String!]!
  unique: Boolean!
  primary: Boolean!
  "The predicate of a partial index; null for a full one."
  where: String
}

type ImportForeignKey {
  name: String!
  columns: [String!]!
  refSchema: String!
  refTable: String!
  refColumns: [String!]!
  "Referential action that writes referencing rows (cascade, set_null, set_default); null when it only checks."
  onDelete: String
  onUpdate: String
}

input TableRef {
  datasource: String!
  schema: String
  "Physical table name (entity source)."
  table: String!
}

type TableComments {
  description: String!
  columns: [ColumnComment!]!
}

type ColumnComment {
  name: String!
  description: String!
}

type ImportColumn {
  name: String!
  type: String!
  nullable: Boolean!
  description: String!
  primaryKey: Boolean!
}

type Validation {
  ok: Boolean!
  error: String
  contentHash: String
  "Changes against the published revision that need a restart."
  restartRequired: [String!]!
  "Grants the routed datasource connections cannot run (they do not block publishing)."
  warnings: [String!]!
}

enum Privilege {
  GRANTED
  DENIED
  UNKNOWN
}

type EntityCapability {
  entity: String!
  action: Action!
  privilege: Privilege!
  "The connection the action routes to."
  connection: String!
  "Columns granted at column level when the table-level privilege is not."
  columns: [String!]
  reason: String
}

enum CapabilityStrength {
  ENFORCED
  BEST_EFFORT
  UNSUPPORTED
}

enum CapabilityEvidence {
  DB_VERIFIED
  CORE_VERIFIED
  DECLARED
  EXTERNAL
}

type CapabilityClaim {
  "Capability key, e.g. limit.timeout.read."
  key: String!
  strength: CapabilityStrength!
  evidence: CapabilityEvidence!
  "How it is provided, or why it is degraded."
  reason: String
}

type ConnectionCapabilities {
  datasource: String!
  connection: String!
  claims: [CapabilityClaim!]!
}

"A statement timeout a datasource relies on that its connection does not enforce on the database side."
type LimitIssue {
  datasource: String!
  connection: String!
  key: String!
  "The work relying on it: reads, writes, procedures or the SQL escape hatch."
  use: String!
  strength: CapabilityStrength!
  reason: String
}

type ProviderCapabilities {
  connections: [ConnectionCapabilities!]!
  "Empty under cost.requireNativeLimits: such a configuration does not load."
  issues: [LimitIssue!]!
}

type ServerStatus {
  "Revision this process serves; null when it does not track the store."
  appliedRevision: ID
  "Whether the process applies newly published revisions (--watch)."
  watching: Boolean!
  "A published revision this process has not applied."
  unapplied: UnappliedRevision
  "What the process runs on its execution bus; null when unknown."
  execution: ExecutionStatus
  "Entities of the served revision whose table or columns are missing from the database; tools refuse them."
  unavailableEntities: [UnavailableEntity!]!
  "Datasources whose schema the served revision could not read; their entities are unavailable until a reload reads it."
  unreachableDatasources: [UnreachableDatasource!]!
}
type UnreachableDatasource {
  datasource: String!
  error: String!
}
type UnavailableEntity {
  "The entity's ID."
  entity: String!
  reason: String!
  "Its table is missing (removing the entity is the fix); false: columns are (syncing its fields is)."
  tableMissing: Boolean!
}
type ExecutionStatus {
  "IO slots every lane draws on."
  io: SlotStatus!
  "The part of the IO slots the lanes other than serve hold together."
  aux: SlotStatus!
  lanes: [LaneStatus!]!
  "Background tasks running, by name."
  tasks: [TaskStatus!]!
}
type SlotStatus {
  size: Int!
  used: Int!
  waiting: Int!
}
type LaneStatus {
  "serve, admin, scan or background."
  name: String!
  maxConcurrent: Int!
  maxQueue: Int!
  inflight: Int!
  queued: Int!
  "Work turned away since the process started."
  rejected: Int!
  "Work run since the process started."
  completed: Int!
}
type TaskStatus {
  name: String!
  running: Int!
}
type UnappliedRevision {
  id: ID!
  "True when only a restart applies it; otherwise building it failed."
  restartRequired: Boolean!
  error: String!
}
input VisibilityInput {
  "Default: the signed-in administrator's workspace."
  revision: ID
  "A configured user name, or role:<name> to evaluate a role."
  user: String!
  subject: JSON
}
input VisibilityFilter {
  "Matches entity IDs containing it, ignoring case."
  search: String
  "Only entities with an allowed or needs-fields action."
  reachableOnly: Boolean
}
type VisibilityPage {
  "Entities evaluated."
  total: Int!
  "Entities with an allowed action, or one whose fields are split across grants (needs fields)."
  reachable: Int!
  "Reachable entities without an allowed action."
  needsFields: Int!
  "Entities matching the filter."
  matched: Int!
  "Actions that apply to at least one entity."
  actions: [Action!]!
  "The page of matching entities, at most 200."
  items: [EntityVisibility!]!
}
type EntityVisibility {
  entity: String!
  "One result per action that applies to the entity kind."
  actions: [ActionVisibility!]!
}
type ActionVisibility {
  action: Action!
  result: Simulation!
}
type Simulation {
  allowed: Boolean!
  reason: String!
  fields: [String!]!
  "Effective row filter in rowPolicies JSON form; null means every row."
  rowFilter: JSON
  grants: [String!]!
  "Set when no single grant covers the requested fields."
  fieldScopes: [[String!]!]
}

type UserToken {
  token: String!
  tokenHash: String!
}

input EntityInput {
  name: String!
  source: String
  datasource: String
  schema: String
  kind: String
  description: String
  primaryKey: [String!]
  uniqueKeys: [[String!]!]
  fields: [FieldInput!]
  relationships: [RelationshipInput!]
  tenantPolicy: JSON
  legacyAccess: JSON
  mcp: EntityMCPInput
  params: [String!]
  affects: [String!]
  allowCascade: Boolean
  allowKeyUpdate: Boolean
}

input FieldInput {
  name: String!
  alias: String
  description: String
  mask: String
  exclude: Boolean
}

input RelationshipInput {
  name: String!
  target: String!
  cardinality: String!
  joinOn: JSON!
}

input EntityMCPInput {
  dmlTools: Boolean
  customTool: Boolean
  trustedProcedure: Boolean
}

input RoleInput {
  name: String!
  description: String
  grants: [GrantInput!]
  permissions: [String!]
  limits: JSON
}

input GrantInput {
  entity: String!
  actions: [Action!]!
  fieldsRestricted: Boolean
  readFields: [String!]
  writeFields: [String!]
  rows: JSON
}

input UserInput {
  name: String!
  description: String
  roles: [String!]
  grants: [GrantInput!]
  permissions: [String!]
  subject: JSON
  disabled: Boolean
  tokenHash: String
  limits: JSON
}

input SimulationInput {
  "Default: the signed-in administrator's workspace."
  revision: ID
  "A configured user name, or role:<name> to evaluate a role."
  user: String!
  entity: String!
  action: Action!
  "Requested fields; empty means the default projection."
  fields: [String!]
  "Extra subject attributes; configured user attributes win."
  subject: JSON
}

input PublishInput {
  "The draft to publish."
  id: ID!
  restartRequired: Boolean = false
  """
  The published revision the caller based its work on; when another revision
  was published since, publish fails with extensions.code CONFLICT.
  """
  expectedPublished: ID
}
input RollbackInput {
  "Revision to restore; default: the newest earlier published content."
  to: ID
  restartRequired: Boolean = false
  comment: String
}

input AdminAccountInput {
  username: String!
  password: String!
  permissions: [String!]!
}

input AdminAccountUpdate {
  username: String!
  permissions: [String!]
  disabled: Boolean
}

input SetAdminPasswordInput {
  username: String!
  password: String!
  "The account's current password: required to change one's own."
  currentPassword: String
}
