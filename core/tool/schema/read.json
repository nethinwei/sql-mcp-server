{
    "type": "object",
    "properties": {
        "entity": {
            "type": "string"
        },
        "transaction": {
            "type": "string",
            "description": "Token returned by begin_transaction"
        },
        "fields": {
            "type": "array",
            "maxItems": 128,
            "items": {
                "type": "string"
            }
        },
        "expand": {
            "type": "array",
            "maxItems": 8,
            "items": {
                "type": "string"
            },
            "description": "Named same-datasource relationships to batch expand"
        },
        "filter": {
            "type": "array",
            "maxItems": 32,
            "items": {
                "$ref": "#/$defs/filter"
            },
            "description": "Conditions that all hold"
        },
        "orderBy": {
            "type": "array",
            "maxItems": 8,
            "description": "Sort order; ties are broken by the entity's key. With a limit, the result carries nextCursor while more rows follow: pass it back as cursor, with the same orderBy, for the next page. Masked fields cannot be ordered by. A related row's field (relationship.field) can be ordered by, without nextCursor.",
            "items": {
                "type": "object",
                "properties": {
                    "field": {
                        "type": "string"
                    },
                    "dir": {
                        "type": "string",
                        "enum": [
                            "asc",
                            "desc"
                        ],
                        "default": "asc"
                    }
                },
                "required": [
                    "field"
                ],
                "additionalProperties": false
            }
        },
        "distinct": {
            "type": "boolean",
            "description": "Drop duplicate rows of the selected fields (needs fields; no expand or cursor)"
        },
        "limit": {
            "type": "integer",
            "minimum": 1
        },
        "offset": {
            "type": "integer",
            "minimum": 0
        },
        "cursor": {
            "type": "object",
            "description": "Keyset pagination: nextCursor of the previous page (with orderBy), or the last row's primary-key values"
        }
    },
    "required": [
        "entity"
    ],
    "dependentRequired": {
        "offset": [
            "limit"
        ]
    },
    "additionalProperties": false,
    "$defs": {
        "filter": {
            "description": "A condition on one field (relationship.field for a related row's field), or a group of them: any (one holds), all (every one holds) or not; or exists: a relationship some target row of which matches its filter. Groups nest at most 4 deep.",
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "op": {
                    "type": "string",
                    "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "in",
                        "not_in",
                        "like",
                        "is_null",
                        "is_not_null"
                    ]
                },
                "value": {
                    "description": "Value (array for in/not_in; omitted for is_null/is_not_null; not null: use is_null to find NULLs)"
                },
                "any": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                        "$ref": "#/$defs/filter"
                    }
                },
                "all": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                        "$ref": "#/$defs/filter"
                    }
                },
                "not": {
                    "$ref": "#/$defs/filter"
                },
                "exists": {
                    "type": "string",
                    "description": "A relationship; with filter on the target's fields"
                },
                "filter": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                        "$ref": "#/$defs/filter"
                    }
                }
            },
            "additionalProperties": false
        }
    }
}
