{
    "type": "object",
    "properties": {
        "entity": {
            "type": "string"
        },
        "transaction": {
            "type": "string",
            "description": "Token returned by begin_transaction"
        },
        "groupBy": {
            "type": "array",
            "maxItems": 8,
            "items": {
                "type": "string"
            }
        },
        "aggregates": {
            "type": "array",
            "maxItems": 16,
            "items": {
                "type": "object",
                "properties": {
                    "func": {
                        "type": "string",
                        "enum": [
                            "count",
                            "sum",
                            "avg",
                            "min",
                            "max"
                        ]
                    },
                    "field": {
                        "type": "string",
                        "description": "Omit for count(*)"
                    },
                    "distinct": {
                        "type": "boolean",
                        "description": "Count distinct values (count with a field only); the column is count_distinct_<field>"
                    }
                },
                "required": [
                    "func"
                ]
            },
            "description": "Result columns: count for count(*), <func>_<field> otherwise"
        },
        "filter": {
            "type": "array",
            "maxItems": 32,
            "items": {
                "$ref": "#/$defs/filter"
            },
            "description": "Conditions that all hold"
        },
        "having": {
            "type": "array",
            "maxItems": 32,
            "items": {
                "$ref": "#/$defs/filter"
            },
            "description": "Conditions on the groups, naming group-by fields or aggregate columns (e.g. sum_amount)"
        },
        "orderBy": {
            "type": "array",
            "maxItems": 8,
            "description": "Sort the groups by group-by fields or aggregate columns (e.g. sum_amount desc)",
            "items": {
                "type": "object",
                "properties": {
                    "field": {
                        "type": "string"
                    },
                    "dir": {
                        "type": "string",
                        "enum": [
                            "asc",
                            "desc"
                        ],
                        "default": "asc"
                    }
                },
                "required": [
                    "field"
                ],
                "additionalProperties": false
            }
        },
        "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "At most this many groups (top N with orderBy)"
        }
    },
    "required": [
        "entity",
        "aggregates"
    ],
    "additionalProperties": false,
    "$defs": {
        "filter": {
            "description": "A condition on one field, or a group of them: any (one holds), all (every one holds) or not. Groups nest at most 4 deep.",
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "op": {
                    "type": "string",
                    "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "in",
                        "not_in",
                        "like",
                        "is_null",
                        "is_not_null"
                    ]
                },
                "value": {
                    "description": "Value (array for in/not_in; omitted for is_null/is_not_null)"
                },
                "any": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                        "$ref": "#/$defs/filter"
                    }
                },
                "all": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                        "$ref": "#/$defs/filter"
                    }
                },
                "not": {
                    "$ref": "#/$defs/filter"
                }
            },
            "additionalProperties": false
        }
    }
}
