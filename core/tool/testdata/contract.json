{
  "tools": {
    "aggregate_records": {
      "$defs": {
        "filter": {
          "additionalProperties": false,
          "description": "A condition on one field, or a group of them: any (one holds), all (every one holds) or not. Groups nest at most 4 deep.",
          "properties": {
            "all": {
              "items": {
                "$ref": "#/$defs/filter"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            "any": {
              "items": {
                "$ref": "#/$defs/filter"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            "field": {
              "type": "string"
            },
            "not": {
              "$ref": "#/$defs/filter"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "not_in",
                "like",
                "is_null",
                "is_not_null"
              ],
              "type": "string"
            },
            "value": {
              "description": "Value (array for in/not_in; omitted for is_null/is_not_null)"
            }
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "aggregates": {
          "description": "Result columns: count for count(*), \u003cfunc\u003e_\u003cfield\u003e otherwise",
          "items": {
            "properties": {
              "distinct": {
                "description": "Count distinct values (count with a field only); the column is count_distinct_\u003cfield\u003e",
                "type": "boolean"
              },
              "field": {
                "description": "Omit for count(*)",
                "type": "string"
              },
              "func": {
                "enum": [
                  "count",
                  "sum",
                  "avg",
                  "min",
                  "max"
                ],
                "type": "string"
              }
            },
            "required": [
              "func"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "type": "array"
        },
        "entity": {
          "type": "string"
        },
        "filter": {
          "description": "Conditions that all hold",
          "items": {
            "$ref": "#/$defs/filter"
          },
          "maxItems": 32,
          "type": "array"
        },
        "groupBy": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "having": {
          "description": "Conditions on the groups, naming group-by fields or aggregate columns (e.g. sum_amount)",
          "items": {
            "$ref": "#/$defs/filter"
          },
          "maxItems": 32,
          "type": "array"
        },
        "limit": {
          "description": "At most this many groups (top N with orderBy)",
          "minimum": 1,
          "type": "integer"
        },
        "orderBy": {
          "description": "Sort the groups by group-by fields or aggregate columns (e.g. sum_amount desc)",
          "items": {
            "additionalProperties": false,
            "properties": {
              "dir": {
                "default": "asc",
                "enum": [
                  "asc",
                  "desc"
                ],
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            },
            "required": [
              "field"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "type": "array"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "aggregates"
      ],
      "type": "object"
    },
    "begin_transaction": {
      "additionalProperties": false,
      "properties": {
        "datasource": {
          "type": "string"
        },
        "isolation": {
          "enum": [
            "read_uncommitted",
            "read_committed",
            "repeatable_read",
            "serializable"
          ],
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "create_record": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        },
        "values": {
          "description": "Column name to value map",
          "type": "object"
        }
      },
      "required": [
        "entity",
        "values"
      ],
      "type": "object"
    },
    "delete_record": {
      "$defs": {
        "filter": {
          "additionalProperties": false,
          "description": "A condition on one field, or a group of them: any (one holds), all (every one holds) or not. Groups nest at most 4 deep.",
          "properties": {
            "all": {
              "items": {
                "$ref": "#/$defs/filter"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            "any": {
              "items": {
                "$ref": "#/$defs/filter"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            "field": {
              "type": "string"
            },
            "not": {
              "$ref": "#/$defs/filter"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "not_in",
                "like",
                "is_null",
                "is_not_null"
              ],
              "type": "string"
            },
            "value": {
              "description": "Value (array for in/not_in; omitted for is_null/is_not_null)"
            }
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string"
        },
        "filter": {
          "description": "Conditions that all hold",
          "items": {
            "$ref": "#/$defs/filter"
          },
          "maxItems": 32,
          "type": "array"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "filter"
      ],
      "type": "object"
    },
    "describe_entities": {
      "additionalProperties": false,
      "properties": {
        "datasource": {
          "description": "When listing, keep entities of this datasource",
          "type": "string"
        },
        "entity": {
          "description": "Entity to describe with its fields and keys; omit to list entities",
          "type": "string"
        },
        "limit": {
          "description": "When listing, entities per page (default 100)",
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "description": "When listing, entities to skip; pass the previous page's nextOffset",
          "minimum": 0,
          "type": "integer"
        },
        "search": {
          "description": "When listing, keep entities whose name, ID or description contains this text (case-insensitive)",
          "type": "string"
        }
      },
      "type": "object"
    },
    "execute_entity": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "description": "Procedure argument name to value map",
          "type": "object"
        },
        "entity": {
          "type": "string"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        }
      },
      "required": [
        "entity"
      ],
      "type": "object"
    },
    "execute_sql": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "description": "Positional parameters, in the dialect's placeholder style ($1 for PostgreSQL, ? for MySQL and OceanBase)",
          "type": "array"
        },
        "datasource": {
          "description": "Datasource the statement runs on; required even when only one is configured",
          "type": "string"
        },
        "mode": {
          "default": "query",
          "description": "query returns columns and rows; exec returns rowsAffected (DML, DDL, SET)",
          "enum": [
            "query",
            "exec"
          ],
          "type": "string"
        },
        "sql": {
          "description": "One statement, run as it is and auto-committed: not parsed, rewritten or masked",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "datasource",
        "sql"
      ],
      "type": "object"
    },
    "read_records": {
      "$defs": {
        "filter": {
          "additionalProperties": false,
          "description": "A condition on one field, or a group of them: any (one holds), all (every one holds) or not. Groups nest at most 4 deep.",
          "properties": {
            "all": {
              "items": {
                "$ref": "#/$defs/filter"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            "any": {
              "items": {
                "$ref": "#/$defs/filter"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            "field": {
              "type": "string"
            },
            "not": {
              "$ref": "#/$defs/filter"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "not_in",
                "like",
                "is_null",
                "is_not_null"
              ],
              "type": "string"
            },
            "value": {
              "description": "Value (array for in/not_in; omitted for is_null/is_not_null)"
            }
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "offset": [
          "limit"
        ]
      },
      "properties": {
        "cursor": {
          "description": "Keyset pagination: nextCursor of the previous page (with orderBy), or the last row's primary-key values",
          "type": "object"
        },
        "distinct": {
          "description": "Drop duplicate rows of the selected fields (needs fields; no expand or cursor)",
          "type": "boolean"
        },
        "entity": {
          "type": "string"
        },
        "expand": {
          "description": "Named same-datasource relationships to batch expand",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "filter": {
          "description": "Conditions that all hold",
          "items": {
            "$ref": "#/$defs/filter"
          },
          "maxItems": 32,
          "type": "array"
        },
        "limit": {
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "orderBy": {
          "description": "Sort order; ties are broken by the entity's key. With a limit, the result carries nextCursor while more rows follow: pass it back as cursor, with the same orderBy, for the next page. Masked fields cannot be ordered by.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "dir": {
                "default": "asc",
                "enum": [
                  "asc",
                  "desc"
                ],
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            },
            "required": [
              "field"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "type": "array"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        }
      },
      "required": [
        "entity"
      ],
      "type": "object"
    },
    "transaction_token": {
      "additionalProperties": false,
      "properties": {
        "transaction": {
          "type": "string"
        }
      },
      "required": [
        "transaction"
      ],
      "type": "object"
    },
    "update_record": {
      "$defs": {
        "filter": {
          "additionalProperties": false,
          "description": "A condition on one field, or a group of them: any (one holds), all (every one holds) or not. Groups nest at most 4 deep.",
          "properties": {
            "all": {
              "items": {
                "$ref": "#/$defs/filter"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            "any": {
              "items": {
                "$ref": "#/$defs/filter"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            "field": {
              "type": "string"
            },
            "not": {
              "$ref": "#/$defs/filter"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "not_in",
                "like",
                "is_null",
                "is_not_null"
              ],
              "type": "string"
            },
            "value": {
              "description": "Value (array for in/not_in; omitted for is_null/is_not_null)"
            }
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string"
        },
        "filter": {
          "description": "Conditions that all hold",
          "items": {
            "$ref": "#/$defs/filter"
          },
          "maxItems": 32,
          "type": "array"
        },
        "set": {
          "description": "Column name to new value map",
          "type": "object"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "filter",
        "set"
      ],
      "type": "object"
    }
  },
  "errorCodes": {
    "AMBIGUOUS_ENTITY": true,
    "AMBIGUOUS_FIELD_SCOPE": true,
    "AUDIT_UNAVAILABLE": false,
    "BUDGET_EXCEEDED": true,
    "CONSTRAINT_VIOLATION": true,
    "COST_EXCEEDED": true,
    "DATABASE_ERROR": false,
    "DATASOURCE_FORBIDDEN": false,
    "DATASOURCE_UNAVAILABLE": true,
    "DML_TOOLS_DISABLED": false,
    "ENTITY_NOT_FOUND": false,
    "ENTITY_UNAVAILABLE": false,
    "INVALID_INPUT": true,
    "OUTCOME_UNKNOWN": false,
    "OVERLOADED": true,
    "RATE_LIMITED": true,
    "TRANSACTION_CAPACITY": true,
    "TRANSACTION_NOT_FOUND": false,
    "TRANSACTION_SCOPE": false,
    "TRANSACTION_STALE": false,
    "UNAUTHORIZED": false,
    "UNSAFE_WRITE": true
  },
  "denialFields": [
    "code",
    "constraints",
    "decisionId",
    "hints",
    "reason",
    "retryable"
  ]
}
