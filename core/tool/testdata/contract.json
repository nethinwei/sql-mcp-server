{
  "tools": {
    "aggregate_records": {
      "additionalProperties": false,
      "properties": {
        "aggregates": {
          "items": {
            "properties": {
              "field": {
                "description": "Omit for count(*)",
                "type": "string"
              },
              "func": {
                "enum": [
                  "count",
                  "sum",
                  "avg",
                  "min",
                  "max"
                ],
                "type": "string"
              }
            },
            "required": [
              "func"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "type": "array"
        },
        "entity": {
          "type": "string"
        },
        "filter": {
          "items": {
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "in",
                  "not_in",
                  "like",
                  "is_null",
                  "is_not_null"
                ],
                "type": "string"
              },
              "value": {
                "description": "Value (array for in/not_in; omitted for is_null/is_not_null)"
              }
            },
            "required": [
              "field",
              "op"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "type": "array"
        },
        "groupBy": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "aggregates"
      ],
      "type": "object"
    },
    "begin_transaction": {
      "additionalProperties": false,
      "properties": {
        "datasource": {
          "type": "string"
        },
        "isolation": {
          "enum": [
            "read_uncommitted",
            "read_committed",
            "repeatable_read",
            "serializable"
          ],
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "create_record": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        },
        "values": {
          "description": "Column name to value map",
          "type": "object"
        }
      },
      "required": [
        "entity",
        "values"
      ],
      "type": "object"
    },
    "delete_record": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string"
        },
        "filter": {
          "items": {
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "in",
                  "not_in",
                  "like",
                  "is_null",
                  "is_not_null"
                ],
                "type": "string"
              },
              "value": {
                "description": "Value (array for in/not_in; omitted for is_null/is_not_null)"
              }
            },
            "required": [
              "field",
              "op"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "type": "array"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "filter"
      ],
      "type": "object"
    },
    "describe_entities": {
      "additionalProperties": false,
      "properties": {
        "datasource": {
          "description": "When listing, keep entities of this datasource",
          "type": "string"
        },
        "entity": {
          "description": "Entity to describe with its fields and keys; omit to list entities",
          "type": "string"
        },
        "limit": {
          "description": "When listing, entities per page (default 100)",
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "description": "When listing, entities to skip; pass the previous page's nextOffset",
          "minimum": 0,
          "type": "integer"
        },
        "search": {
          "description": "When listing, keep entities whose name, ID or description contains this text (case-insensitive)",
          "type": "string"
        }
      },
      "type": "object"
    },
    "execute_entity": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "description": "Procedure argument name to value map",
          "type": "object"
        },
        "entity": {
          "type": "string"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        }
      },
      "required": [
        "entity"
      ],
      "type": "object"
    },
    "execute_sql": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "description": "Positional parameters, in the dialect's placeholder style ($1 for PostgreSQL, ? for MySQL and OceanBase)",
          "type": "array"
        },
        "datasource": {
          "description": "Datasource the statement runs on; required even when only one is configured",
          "type": "string"
        },
        "mode": {
          "default": "query",
          "description": "query returns columns and rows; exec returns rowsAffected (DML, DDL, SET)",
          "enum": [
            "query",
            "exec"
          ],
          "type": "string"
        },
        "sql": {
          "description": "One statement, run as it is and auto-committed: not parsed, rewritten or masked",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "datasource",
        "sql"
      ],
      "type": "object"
    },
    "read_records": {
      "additionalProperties": false,
      "dependentRequired": {
        "offset": [
          "limit"
        ]
      },
      "properties": {
        "cursor": {
          "description": "Keyset pagination: last row's primary-key column values to resume after",
          "type": "object"
        },
        "entity": {
          "type": "string"
        },
        "expand": {
          "description": "Named same-datasource relationships to batch expand",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "type": "array"
        },
        "filter": {
          "items": {
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "in",
                  "not_in",
                  "like",
                  "is_null",
                  "is_not_null"
                ],
                "type": "string"
              },
              "value": {
                "description": "Value (array for in/not_in; omitted for is_null/is_not_null)"
              }
            },
            "required": [
              "field",
              "op"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "type": "array"
        },
        "limit": {
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        }
      },
      "required": [
        "entity"
      ],
      "type": "object"
    },
    "transaction_token": {
      "additionalProperties": false,
      "properties": {
        "transaction": {
          "type": "string"
        }
      },
      "required": [
        "transaction"
      ],
      "type": "object"
    },
    "update_record": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string"
        },
        "filter": {
          "items": {
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "in",
                  "not_in",
                  "like",
                  "is_null",
                  "is_not_null"
                ],
                "type": "string"
              },
              "value": {
                "description": "Value (array for in/not_in; omitted for is_null/is_not_null)"
              }
            },
            "required": [
              "field",
              "op"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "type": "array"
        },
        "set": {
          "description": "Column name to new value map",
          "type": "object"
        },
        "transaction": {
          "description": "Token returned by begin_transaction",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "filter",
        "set"
      ],
      "type": "object"
    }
  },
  "errorCodes": {
    "AMBIGUOUS_ENTITY": true,
    "AMBIGUOUS_FIELD_SCOPE": true,
    "AUDIT_UNAVAILABLE": false,
    "BUDGET_EXCEEDED": true,
    "CONSTRAINT_VIOLATION": true,
    "COST_EXCEEDED": true,
    "DATABASE_ERROR": false,
    "DATASOURCE_FORBIDDEN": false,
    "DATASOURCE_UNAVAILABLE": true,
    "DML_TOOLS_DISABLED": false,
    "ENTITY_NOT_FOUND": false,
    "ENTITY_UNAVAILABLE": false,
    "INVALID_INPUT": true,
    "OUTCOME_UNKNOWN": false,
    "OVERLOADED": true,
    "RATE_LIMITED": true,
    "TRANSACTION_CAPACITY": true,
    "TRANSACTION_NOT_FOUND": false,
    "TRANSACTION_SCOPE": false,
    "TRANSACTION_STALE": false,
    "UNAUTHORIZED": false,
    "UNSAFE_WRITE": true
  },
  "denialFields": [
    "code",
    "constraints",
    "decisionId",
    "hints",
    "reason",
    "retryable"
  ]
}
